// Quantis Terminal · config/firestore.rules — Firestore security rules for the optional Cloud Sync.
// Each signed-in user can read/write ONLY users/{their uid}; everything else is denied.
// Deploy:  firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && request.resource.data.keys().size() < 200;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
